# Medusa backend URL. On a physical device or Android emulator, localhost won't
# reach your machine: use your LAN IP (e.g. http://192.168.1.20:9000) or
# http://10.0.2.2:9000 for the Android emulator. In production, use the Railway URL.
EXPO_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from Medusa Admin → Settings → Publishable API Keys
# (the seed script prints one). Linked to the sales channel the app sells through.
EXPO_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me
