{
  "name": "shelby-backend",
  "version": "0.0.1",
  "description": "Shelby store backend (Medusa v2) with product-drop release workflow",
  "author": "Shelby",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "predeploy": "medusa db:migrate",
    "start:prod": "cd .medusa/server && npm run predeploy && npm run start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@medusajs/admin-sdk": "2.22.7",
    "@medusajs/cli": "2.22.7",
    "@medusajs/framework": "2.22.7",
    "@medusajs/icons": "2.22.7",
    "@medusajs/js-sdk": "2.22.7",
    "@medusajs/medusa": "2.22.7",
    "@medusajs/ui": "4.2.14",
    "@tanstack/react-query": "5.64.2"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.22.7",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
