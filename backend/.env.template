# Copy to .env for local development.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shelby
REDIS_URL=redis://localhost:6379

# Comma-separated origins. Native apps don't send an Origin header, so STORE_CORS
# only matters for the Expo web build (8081 is the Expo dev server).
STORE_CORS=http://localhost:8081,http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8081

JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# "shared" locally. On Railway: "server" for the API service, "worker" for the worker.
MEDUSA_WORKER_MODE=shared
MEDUSA_BACKEND_URL=http://localhost:9000

# Optional: product image storage (S3-compatible). For a private Railway bucket,
# S3_FILE_URL=<MEDUSA_BACKEND_URL>/media (served by src/api/media via presigned redirects).
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FILE_URL=
# S3_FORCE_PATH_STYLE=false

# Optional: "notify me" emails via SendGrid (otherwise logged)
# SENDGRID_API_KEY=
# SENDGRID_FROM=

# Optional: Stripe payments
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CAPTURE=manual   # default: capture at checkout

# Analytics are first-party (docs/analytics.md): events live in this database,
# nothing to configure. Day buckets in reports use this timezone.
# STORE_TIMEZONE=America/Los_Angeles
# Base URL for the tracked links shown in Admin → Content
# STOREFRONT_URL=http://localhost:3000
